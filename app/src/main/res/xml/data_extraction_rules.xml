<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="file" path="media/" />
        <include domain="file" path="fonts/" />
        <include domain="file" path="custom_fonts/" />
        <exclude domain="file" path="baked_cache/" />
        <exclude domain="file" path="ipc_state/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="file" path="media/" />
        <include domain="file" path="fonts/" />
        <include domain="file" path="custom_fonts/" />
        <exclude domain="file" path="baked_cache/" />
        <exclude domain="file" path="ipc_state/" />
    </device-transfer>
</data-extraction-rules>
